{
  "name": "@escrcpy/workspace",
  "type": "module",
  "version": "2.11.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Scrcpy Powered by Electron",
  "author": "involvex",
  "funding": {
    "url": "https://github.com/sponsors/involvex"
  },
  "main": "desktop/dist-electron/main.js",
  "bin": {
    "escrcpy": "bin/cli.js"
  },
  "workspaces": [
    "packages/*",
    "desktop"
  ],
  "scripts": {
    "prebuild": "bun run format",
    "build": "turbo build:electron",
    "build:linux": "turbo build:electron -- --linux",
    "build:mac": "turbo build:electron -- --mac",
    "build:win": "turbo build:electron -- --win",
    "clean": "bunx rimraf --glob \"**/node_modules\" \"**/dist*\" \"**/.turbo\" || $true",
    "dev": "turbo dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "electron-fix": "bunx --filter escrcpy electron-fix",
    "format": "prettier --write .",
    "lang-sync": "node ./scripts/lang-sync.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "dependencies": {
    "i18next-json-sync": "^3.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-format": "2.0.1",
    "ga-gtag": "1.2.0",
    "husky": "9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-markdown-html": "^1.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prettier-plugin-toml": "^2.0.6",
    "prettier-plugin-yaml": "^1.3.2",
    "publint": "0.3.25",
    "turbo": "^2.11.13",
    "vitepress": "1.6.4",
    "vitepress-i18n": "1.5.0",
    "vitepress-sidebar": "1.41.0"
  },
  "overrides": {
    "electron": "43.8.13",
    "sharp": "^0.35.5",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite": "6.4.6"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/involvex"
  }
}
